# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# MongoDB connection string (used by FastAPI backend in Docker Compose)
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=entrepreneur_ai

# JWT signing secret (leave blank in dev for secure random fallback, set a strong 32+ char secret in production)
JWT_SECRET=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
